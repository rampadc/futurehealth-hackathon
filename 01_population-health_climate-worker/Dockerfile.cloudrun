FROM node:22-bookworm-slim AS ui
WORKDIR /build/ui
COPY supervisor-ui/package.json supervisor-ui/package-lock.json ./
RUN npm ci
COPY supervisor-ui/ ./
COPY demo/cross-scenario/personnel.json /build/demo/cross-scenario/personnel.json
COPY demo/solver/operational-results.json /build/demo/solver/operational-results.json
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.9.4 AS uv

FROM python:3.13-slim
COPY --from=uv /uv /bin/uv
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy PATH=/app/.venv/bin:$PATH \
    HEAT_SOLVER_PYTHON=/app/.solver-venv/bin/python

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY demo/solver/requirements.lock /tmp/solver-requirements.lock
RUN uv venv /app/.solver-venv && uv pip sync --python /app/.solver-venv/bin/python /tmp/solver-requirements.lock

COPY src/ src/
COPY agents/ agents/
COPY demo/ demo/
COPY data/heat_safe/ data/heat_safe/
COPY tools/run_cloud.py tools/run_cloud.py
COPY --from=ui /build/ui/dist/ static/
RUN uv sync --frozen --no-dev && useradd --uid 10001 --create-home app && chown -R app:app /app
USER 10001
EXPOSE 8080
ENTRYPOINT ["python", "/app/tools/run_cloud.py"]
