# Copy to .env and replace placeholders. Never commit credentials or access codes.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=me-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Use an absolute path to your own ADC file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
HEAT_SAFE_MODEL=gemini-3.5-flash
HEAT_SAFE_MODEL_LOCATION=global
HEAT_SAFE_ARMOR_LOCATION=asia-south1
