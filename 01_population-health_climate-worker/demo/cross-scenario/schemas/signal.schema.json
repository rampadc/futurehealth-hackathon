            "properties": {
              "using_sensor_id": {
                "type": "string"
              },
              "expect_reject": {
                "type": "string"
              },
              "zone_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "clock"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "minutes"
            ],
            "properties": {
              "minutes": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "escalate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "alert_id"
