            "properties": {
              "case_id": {
                "type": "string"
              },
              "person_id": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "first_aid"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "action",
              "actor_id",
              "person_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "person_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "restart_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "expect_reject",
              "task_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              },
              "expect_reject": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
