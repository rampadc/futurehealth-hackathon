          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "checks",
              "task_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "restart"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "task_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "handover"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "case_id",
              "references",
              "unresolved"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "case_id": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}
