{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandline signal envelope",
  "type": "object",
  "required": [
    "event_id",
    "scenario_id",
    "occurred_at",
    "received_at",
    "source",
    "synthetic",
    "type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "synthetic_fixture"
    },
    "synthetic": {
      "const": true
    },
    "type": {
      "enum": [
        "ack",
        "assign",
        "assign_attempt",
        "check",
        "clearance_attempt",
        "clock",
        "delivery_accept",
        "delivery_approve",
        "delivery_draft",
        "delivery_send",
        "escalate",
        "first_aid",
        "forecast",
        "handover",
        "hold",
        "recommendation",
        "recover",
        "restart",
        "restart_attempt",
        "review",
        "sensor_fail",
        "stop",
        "symptom",
        "twl"
      ]
    },
    "payload": {
      "type": "object"
    },
    "actor_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "forecast"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "max_air_c",
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "max_air_c": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "recommendation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "clearance",
              "kind",
              "tasks"
            ],
            "properties": {
              "clearance": {
                "type": "boolean"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "twl"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "measured_at",
              "quality",
              "sensor_id",
              "twl",
              "unit",
              "zone_id"
            ],
            "properties": {
              "quality": {
                "type": "string"
              },
              "sensor_id": {
                "type": "string"
              },
              "measured_at": {
                "type": "string"
              },
              "twl": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "zone_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hold"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "alert_id",
              "case_id",
              "task_id"
            ],
            "properties": {
              "alert_id": {
                "type": "string"
              },
              "case_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
