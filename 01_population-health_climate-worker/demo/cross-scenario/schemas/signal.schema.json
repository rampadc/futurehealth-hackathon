              "synthetic_external_message": {
                "type": "boolean"
              },
              "recipient": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "delivery_accept"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor"
            ],
            "properties": {
              "actor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sensor_fail"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "sensor_id"
            ],
            "properties": {
              "sensor_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "clearance_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "expect_reject",
