            "const": "ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "alert_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "alert_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "actor_id",
              "task_id"
            ],
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "recover"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "person_ids",
              "zone_id"
            ],
            "properties": {
              "person_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "zone_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assign_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "expect_reject",
              "person_ids",
              "task_id",
              "zone_id"
            ],
            "properties": {
              "person_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "task_id": {
                "type": "string"
              },
              "expect_reject": {
                "type": "string"
              },
              "zone_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assign"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "person_ids",
              "task_id",
              "zone_id"
            ],
            "properties": {
              "person_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "task_id": {
                "type": "string"
              },
              "zone_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "person_ids",
              "task_id"
            ],
            "properties": {
              "person_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "delivery_draft"
